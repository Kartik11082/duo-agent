# Copy this file to .env and edit as needed. .env is gitignored.
# Secrets and per-machine values only; the model and the connectors are set
# in agent.yaml.
OLLAMA_BASE_URL=http://localhost:11434

# Telegram: token from @BotFather; chat ID from
# https://api.telegram.org/bot<TOKEN>/getUpdates after messaging your bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
APPROVAL_TIMEOUT_HOURS=24

# Postgres in Docker (docker-compose.yml). Local-only credentials: pick your
# own, and keep DATABASE_URL in sync with the three lines above it.
# Use 127.0.0.1, not localhost: on Windows, localhost tries IPv6 (::1) first,
# where nothing listens, and connecting stalls.
POSTGRES_USER=duo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=duo
DATABASE_URL=postgresql://duo:change-me@127.0.0.1:5432/duo

# GitHub webhook secret: any long random string, also entered on the webhook
GITHUB_WEBHOOK_SECRET=

# GitHub App: App ID from the app's settings page, path to its private key
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=C:\Users\you\.secrets\duo-agent.pem
